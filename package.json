{
  "name": "synapsecity-sos",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "SynapseCity emergency operations product",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:service": "npm run build --workspace=@synapsecity/sos-service",
    "start:service": "npm run start --workspace=@synapsecity/sos-service",
    "start:gateway": "npm run start --workspace=@synapsecity/sos-gateway",
    "demo:seed": "node scripts/demo-seed.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "plugins:check": "node scripts/plugin-bundle.mjs check",
    "plugins:reseal": "node scripts/plugin-bundle.mjs reseal",
    "plugins:export": "node scripts/plugin-bundle.mjs export",
    "plugins:import": "node scripts/plugin-bundle.mjs import",
    "plugins:sync": "node scripts/plugin-bundle.mjs sync",
    "plugins:test": "node --test --test-concurrency=1 scripts/plugin-bundle.test.mjs",
    "test:public-only": "node --test --test-concurrency=1 scripts/public-only.test.mjs",
    "test:workflow-artifacts": "node --test --test-concurrency=1 scripts/workflow-artifacts.test.mjs",
    "test:workflow-engine": "node --test --test-concurrency=1 scripts/workflow-engine.test.mjs",
    "test:aar-parity": "node --test --test-concurrency=1 --test-name-pattern='workflow AAR matches' scripts/workflow-engine.test.mjs",
    "workflows:validate": "node workflows/validate.mjs"
  }
}
