{
  "name": "@synapsecity/sos-console",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_USE_MOCK_DATA=true vite",
    "build": "tsc -b && vite build && node scripts/ensure-spdx.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest --config=vitest.unit.config.ts run",
    "test:e2e": "vitest --config=vitest.browser.config.ts --run",
    "test:e2e:ui": "vitest --config=vitest.browser.config.ts --ui",
    "test:e2e:headed": "vitest --config=vitest.browser.config.ts --browser.headless=false --run",
    "test:coverage": "vitest --config=vitest.unit.config.ts --coverage --run",
    "test:browser": "vitest --config=vitest.browser.config.ts --run"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@tanstack/react-query": "^5.90.10",
    "@tanstack/react-router": "^1.139.10",
    "autoprefixer": "^10.4.22",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.554.0",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.17",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@tanstack/router-devtools": "^1.139.10",
    "@tanstack/router-plugin": "^1.139.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser": "^4.0.14",
    "@vitest/browser-playwright": "^4.0.14",
    "@vitest/ui": "^4.0.14",
    "class-variance-authority": "^0.7.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^27.2.0",
    "tailwind-merge": "^3.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.3.6",
    "vitest": "^4.0.14",
    "vitest-browser-react": "^2.0.2"
  },
  "description": "SynapseCity emergency operations console"
}
