{
  "expo": {
    "name": "SynapseSOS",
    "slug": "synapsecity-sos",
    "version": "0.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "synapsecitysos",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sbs.synapsecity.sos"
    },
    "android": {
      "package": "sbs.synapsecity.sos",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C2410C",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SynapseSOS dùng vị trí của bạn để hiển thị cảnh báo thiên tai, sự kiện khẩn cấp và nơi trú ẩn gần nhất."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F59E0B",
          "defaultChannel": "sos-alerts"
        }
      ],
      "expo-secure-store",
      "expo-background-task",
      "expo-image",
      "expo-splash-screen",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 37,
            "targetSdkVersion": 37,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "extra": {
      "productUrl": "https://sos.synapsecity.sbs"
    }
  }
}
