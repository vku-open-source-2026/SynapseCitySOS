# Public GHCR images: ghcr.io/<owner>/synapsecitysos-<service>:<version>.
# Pin a release tag for reproducible self-hosting, or keep `latest`.
SYNAPSECITYSOS_VERSION=latest
SYNAPSECITYSOS_IMAGE_OWNER=vku-open-source-2026

NODE_ENV=production
# sos-service container port. This is internal to the SynapseCitySOS stack and
# is not published on the host.
PORT=8084
# Host port used to reach the gateway container (which always listens on 8080).
GATEWAY_HOST_PORT=8086
# Gateway -> emergency domain service route inside the Tier-3 product stack.
SOS_SERVICE_URL=http://sos-service:8084
# Gateway -> console route inside the Tier-3 product stack.
CONSOLE_URL=http://console:80
# Public Tier-2 URL. Do not set this to a private port or localhost.
SYNAPSEDX_BASE_URL=https://synapsedx.sbs
SYNAPSEDX_API_KEY=
# Tier-2 request timeout (ms) for ordinary records/datasets/events/jobs calls.
SYNAPSEDX_TIMEOUT_MS=20000
# Tier-2 AI timeout (ms) for EOP draft generation.
SYNAPSEDX_AI_TIMEOUT_MS=45000
# Hazard SSE polls the Tier-2 event feed at this interval (ms) and refreshes the
# snapshot only when a hazard record event arrives. It falls back to a 30s
# snapshot poll only when the event feed is unavailable.
SOS_STREAM_EVENT_POLL_MS=2000
SYNAPSEDX_TOKEN=
# Optional HMAC secret for the SOS auth shell. Set a strong value in production;
# if empty, the service generates an ephemeral secret at startup (sessions are
# invalidated on restart). Production identity is delegated to Tier-1 IAM
# through the Tier-2 auth capability.
AUTH_SECRET=
# Identity source for /v1/auth/*. `tier2` (default) verifies email/password with
# the Tier-2 auth capability (Tier-1 IAM backed) and keeps the Tier-2
# access/refresh token inside the signed SOS session. `demo` is a
# development-only shell that also requires ALLOW_DEMO_AUTH=true and
# NODE_ENV != production; NODE_ENV=production refuses SOS_AUTH_MODE=demo.
SOS_AUTH_MODE=tier2
# Comma-separated, lower-cased emails that receive the `admin` role after a
# successful Tier-2 login/registration. Everyone else is a responder. The role
# is server-side only; a client-supplied `role` is always ignored.
SOS_BOOTSTRAP_ADMIN_EMAILS=
# Fallback role for verified identities that are not bootstrap admins.
# `admin` is not accepted here; only SOS_BOOTSTRAP_ADMIN_EMAILS grants admin.
SOS_AUTH_DEFAULT_ROLE=responder
# Optional delegated-token exchange (service credential -> user-scoped token).
# When enabled, the login token is exchanged for a `synapsecity-sos` audience
# token; a 403 exchange keeps the user-scoped login token instead of failing.
SOS_AUTH_EXCHANGE=false
SOS_AUTH_EXCHANGE_SCOPES=read,write
# Development-only demo shell. It is honoured only with SOS_AUTH_MODE=demo and a
# non-production NODE_ENV; production refuses to start when true. Demo login is
# always a responder session; registration is read-only. A client-supplied role
# is ignored and demo sessions never grant admin.
ALLOW_DEMO_AUTH=false
# Optional fixed demo role (admin/manager/operator are refused).
SOS_DEMO_AUTH_ROLE=responder
# Per-process rate limits (defence in depth; nginx also limits at the edge).
RATE_LIMIT_AUTH_MAX=60
RATE_LIMIT_STREAM_MAX=30
RATE_LIMIT_GEO_MAX=120
RATE_LIMIT_AI_MAX=30
RATE_LIMIT_DISABLED=false
# VNDMS ingest status becomes `stale` after this many minutes without a
# successful batch. Ingestion itself is scheduled by Tier-2, not by SOS.
VNDMS_STALE_MINUTES=60
# Allow localhost Tier-2 URLs for local tests only. Must stay false in production.
ALLOW_LOCAL_DEPENDENCIES=false
CORS_ORIGIN=https://sos.synapsecity.sbs
# Gateway upstream timeouts (milliseconds).
GATEWAY_TIMEOUT_MS=10000
GATEWAY_CONSOLE_TIMEOUT_MS=15000
# Rust gateway log filter (tracing EnvFilter syntax).
RUST_LOG=info
