NODE_ENV=production
# sos-service container port. This is internal to the SynapseCitySOS stack and
# is not published on the host.
PORT=8084
# Host port used to reach the gateway container (which always listens on 8080).
GATEWAY_HOST_PORT=8086
# Gateway -> emergency domain service route inside the Tier-3 product stack.
SOS_SERVICE_URL=http://sos-service:8084
# Gateway -> console route inside the Tier-3 product stack.
CONSOLE_URL=http://console:80
# Public Tier-2 URL. Do not set this to a private port or localhost.
SYNAPSEDX_BASE_URL=https://synapsedx.sbs
SYNAPSEDX_API_KEY=
# Tier-2 request timeout (ms) for ordinary records/datasets/events/jobs calls.
SYNAPSEDX_TIMEOUT_MS=20000
# Tier-2 AI timeout (ms) for EOP draft generation.
SYNAPSEDX_AI_TIMEOUT_MS=45000
# Hazard SSE polls the Tier-2 event feed at this interval (ms) and refreshes the
# snapshot only when a hazard record event arrives. It falls back to a 30s
# snapshot poll only when the event feed is unavailable.
SOS_STREAM_EVENT_POLL_MS=2000
# Server-side VIETMAP key. Never expose this as VITE_* or commit the value.
VIETMAP_API_KEY=
VIETMAP_TILE_STYLE=tm
SYNAPSEDX_TOKEN=
# Optional HMAC secret for the SOS auth shell. Set a strong value in production;
# if empty, the service generates an ephemeral secret at startup (sessions are
# invalidated on restart). Production identity must be delegated to Tier-1 IAM.
AUTH_SECRET=
# The demo login/register shell is OFF by default and refuses to start with
# NODE_ENV=production when true. Enable only for a non-production demo.
# Demo login is always a responder session; registration is read-only. A
# client-supplied role is ignored and demo sessions never grant admin.
ALLOW_DEMO_AUTH=false
# Optional fixed demo role (admin/manager/operator are refused).
SOS_DEMO_AUTH_ROLE=responder
# Per-process rate limits (defence in depth; nginx also limits at the edge).
RATE_LIMIT_AUTH_MAX=60
RATE_LIMIT_STREAM_MAX=30
RATE_LIMIT_GEO_MAX=120
RATE_LIMIT_AI_MAX=30
RATE_LIMIT_DISABLED=false
# VNDMS ingest status becomes `stale` after this many minutes without a
# successful batch. Ingestion itself is scheduled by Tier-2, not by SOS.
VNDMS_STALE_MINUTES=60ALLOW_LOCAL_DEPENDENCIES=false
CORS_ORIGIN=https://sos.synapsecity.sbs
# Gateway upstream timeouts (milliseconds).
GATEWAY_TIMEOUT_MS=10000
GATEWAY_CONSOLE_TIMEOUT_MS=15000
