{
  "format": "synapsedx-plugin",
  "formatVersion": 1,
  "plugin": {
    "product": "sos",
    "name": "Emergency EOP console",
    "slug": "sos-eop-console",
    "audience": "admin",
    "roles": [
      "admin",
      "manager",
      "operator"
    ],
    "widgets": [
      {
        "id": "intro",
        "text": "Draft, review, approve and publish EOP plans for an event. Complex plan sections are JSON fields so the plan remains source-reviewable and portable.",
        "type": "heading",
        "title": "Emergency operations plans",
        "width": "full"
      },
      {
        "id": "workspace-navigation",
        "type": "navigation",
        "title": "Quick access",
        "width": "full",
        "links": [
          {
            "label": "Overview",
            "target": "page:sos-command-overview",
            "actionId": "act-workspace-navigation-link1"
          },
          {
            "label": "Hazard watch",
            "target": "page:sos-hazard-watch",
            "actionId": "act-workspace-navigation-link2"
          },
          {
            "label": "Dispatch",
            "target": "page:sos-dispatch-board",
            "actionId": "act-workspace-navigation-link3"
          },
          {
            "label": "Resources",
            "target": "page:sos-resource-registry",
            "actionId": "act-workspace-navigation-link4"
          },
          {
            "label": "Team tasks",
            "target": "module:tasks",
            "actionId": "act-workspace-navigation-link5"
          }
        ]
      },
      {
        "id": "eop-metric",
        "type": "metric",
        "title": "EOP plans",
        "width": "half",
        "resource": "eop",
        "onLoad": "act-eop-metric-load"
      },
      {
        "id": "events-metric",
        "type": "metric",
        "title": "Events",
        "width": "half",
        "resource": "events",
        "onLoad": "act-events-metric-load"
      },
      {
        "id": "records-section",
        "type": "divider",
        "title": "Operational picture",
        "width": "full"
      },
      {
        "id": "eop-table",
        "type": "table",
        "title": "EOP plans",
        "width": "full",
        "columns": [
          "id",
          "emergency_event_id",
          "version",
          "title",
          "status",
          "generated_by",
          "approved_at",
          "published_at"
        ],
        "resource": "eop",
        "onLoad": "act-eop-table-load",
        "onRowClick": "act-eop-table-row",
        "onExport": "act-eop-table-export"
      },
      {
        "id": "actions-section",
        "type": "divider",
        "title": "Take action",
        "width": "full"
      },
      {
        "id": "eop-create",
        "type": "form",
        "title": "Create an EOP plan",
        "width": "full",
        "action": "create",
        "fields": [
          {
            "name": "emergency_event_id",
            "type": "text",
            "label": "Event id",
            "required": true
          },
          {
            "name": "title",
            "type": "text",
            "label": "Title",
            "required": true
          },
          {
            "name": "summary",
            "type": "textarea",
            "label": "Summary"
          },
          {
            "name": "objectives_json",
            "type": "json",
            "label": "Objectives (JSON array)",
            "selectionPath": "objectives"
          },
          {
            "name": "operational_phases_json",
            "type": "json",
            "label": "Operational phases (JSON array)",
            "selectionPath": "operational_phases"
          },
          {
            "name": "actions_json",
            "type": "json",
            "label": "Actions (JSON array)",
            "selectionPath": "actions"
          },
          {
            "name": "evacuation_plan_json",
            "type": "json",
            "label": "Evacuation plan (JSON array)",
            "selectionPath": "evacuation_plan"
          },
          {
            "name": "fallback_plan_json",
            "type": "json",
            "label": "Fallback plan (JSON array)",
            "selectionPath": "fallback_plan"
          },
          {
            "name": "communications_plan_json",
            "type": "json",
            "label": "Communications plan (JSON array)",
            "selectionPath": "communications_plan"
          }
        ],
        "resource": "eop",
        "workflowRef": {
          "name": "sos-workspace-actions",
          "checksum": "a70d370aa5ce3051466c84b94f6ade67cb5f281d214ab9ebba3884a55bf6d8cb"
        },
        "onSubmit": "act-eop-create-submit"
      },
      {
        "id": "eop-update",
        "type": "form",
        "title": "Update an EOP plan",
        "width": "full",
        "action": "update",
        "fields": [
          {
            "name": "record_id",
            "type": "text",
            "label": "EOP id",
            "required": true
          },
          {
            "name": "title",
            "type": "text",
            "label": "Title"
          },
          {
            "name": "summary",
            "type": "textarea",
            "label": "Summary"
          },
          {
            "name": "markdown_body",
            "type": "textarea",
            "label": "Plan body"
          },
          {
            "name": "review_notes",
            "type": "textarea",
            "label": "Review notes"
          }
        ],
        "resource": "eop",
        "workflowRef": {
          "name": "sos-workspace-actions",
          "checksum": "a70d370aa5ce3051466c84b94f6ade67cb5f281d214ab9ebba3884a55bf6d8cb"
        },
        "onSubmit": "act-eop-update-submit"
      },
      {
        "id": "eop-decision",
        "type": "form",
        "title": "Review or publish an EOP",
        "width": "half",
        "action": "execute",
        "fields": [
          {
            "name": "record_id",
            "type": "text",
            "label": "EOP id",
            "required": true
          },
          {
            "name": "decision",
            "type": "text",
            "label": "Decision: submit, reject or archive (approve/publish via SOS HITL)",
            "required": true
          },
          {
            "name": "notes",
            "type": "textarea",
            "label": "Review note"
          }
        ],
        "resource": "eop",
        "workflowRef": {
          "name": "sos-workspace-actions",
          "checksum": "a70d370aa5ce3051466c84b94f6ade67cb5f281d214ab9ebba3884a55bf6d8cb"
        },
        "onSubmit": "act-eop-decision-submit"
      },
      {
        "id": "eop-delete",
        "type": "form",
        "title": "Delete an EOP draft",
        "width": "half",
        "action": "delete",
        "fields": [
          {
            "name": "record_id",
            "type": "text",
            "label": "EOP id",
            "required": true
