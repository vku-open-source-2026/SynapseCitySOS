{
  "format": "synapsedx-plugin",
  "formatVersion": 1,
  "plugin": {
    "product": "sos",
    "name": "SOS volunteer desk",
    "audience": "member",
    "roles": [
      "volunteer"
    ],
    "widgets": [
      {
        "id": "intro",
        "type": "heading",
        "title": "Volunteer situation picture",
        "text": "Read the public-facing event and resource picture. Volunteer access is intentionally read-only; operational dispatch and medical data remain with responders and command staff.",
        "width": "full"
      },
      {
        "id": "workspace-navigation",
        "type": "navigation",
        "title": "Quick access",
        "width": "full",
        "links": [
          {
            "label": "Overview",
            "target": "page:sos-command-overview",
            "actionId": "act-workspace-navigation-link1"
          },
          {
            "label": "Hazard watch",
            "target": "page:sos-hazard-watch",
            "actionId": "act-workspace-navigation-link2"
          },
          {
            "label": "Dispatch",
            "target": "page:sos-dispatch-board",
            "actionId": "act-workspace-navigation-link3"
          },
          {
            "label": "Resources",
            "target": "page:sos-resource-registry",
            "actionId": "act-workspace-navigation-link4"
          },
          {
            "label": "Team tasks",
            "target": "module:tasks",
            "actionId": "act-workspace-navigation-link5"
          }
        ]
      },
      {
        "id": "events-metric",
        "type": "metric",
        "title": "Events",
        "resource": "events",
        "width": "half",
        "onLoad": "act-events-metric-load"
      },
      {
        "id": "resources-metric",
        "type": "metric",
        "title": "Shelters and resources",
        "resource": "resources",
        "width": "half",
        "onLoad": "act-resources-metric-load"
      },
      {
        "id": "hazards-metric",
        "type": "metric",
        "title": "Hazard layers",
        "resource": "hazards",
        "width": "half",
        "onLoad": "act-hazards-metric-load"
      },
      {
        "id": "records-section",
        "type": "divider",
        "title": "Operational picture",
        "width": "full"
      },
      {
        "id": "events-table",
        "type": "list",
        "title": "Event picture",
        "resource": "events",
        "columns": [
          "id",
          "event_code",
          "title",
          "event_type",
          "severity",
          "status",
          "started_at"
        ],
        "width": "full",
        "onLoad": "act-events-table-load",
        "onRowClick": "act-events-table-row",
        "onExport": "act-events-table-export"
      },
      {
        "id": "resources-table",
        "type": "table",
        "title": "Shelters and resource units",
        "resource": "resources",
        "columns": [
          "id",
          "resource_code",
          "name",
          "resource_type",
          "status",
          "district",
          "capacity",
          "capacity_unit"
        ],
        "width": "full",
        "onLoad": "act-resources-table-load",
        "onRowClick": "act-resources-table-row",
        "onExport": "act-resources-table-export"
      },
      {
        "id": "hazards-table",
        "type": "table",
        "title": "Hazard context",
        "resource": "hazards",
        "columns": [
          "id",
          "hazard_id",
          "title",
          "event_type",
          "severity",
          "is_active",
          "district",
          "expires_at"
        ],
        "width": "full",
        "onLoad": "act-hazards-table-load",
        "onRowClick": "act-hazards-table-row",
        "onExport": "act-hazards-table-export"
      },
