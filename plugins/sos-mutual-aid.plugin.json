        "title": "Mutual-aid requests",
        "width": "full",
        "columns": [
          "id",
          "request_number",
          "requesting_agency",
          "resource_type",
          "quantity",
          "filled_quantity",
          "urgency",
          "status"
        ],
        "resource": "mutualAid",
        "onLoad": "act-mutual-aid-table-load",
        "onRowClick": "act-mutual-aid-table-row",
        "onExport": "act-mutual-aid-table-export"
      },
      {
        "id": "actions-section",
        "type": "divider",
        "title": "Take action",
        "width": "full"
      },
      {
        "id": "mutual-aid-create",
        "type": "form",
        "title": "Create a mutual-aid request",
        "width": "full",
        "action": "create",
        "fields": [
          {
            "name": "requesting_agency",
            "type": "text",
            "label": "Requesting agency",
            "required": true
          },
          {
            "name": "resource_type",
            "type": "text",
            "label": "Resource type",
            "required": true
          },
          {
            "name": "quantity",
            "type": "number",
            "label": "Quantity",
            "required": true
          },
          {
            "name": "urgency",
            "type": "text",
            "label": "Urgency: low, medium, high or critical"
          },
          {
            "name": "location_json",
            "type": "textarea",
            "label": "Location JSON (city, address)"
          },
          {
            "name": "contact_json",
            "type": "textarea",
            "label": "Contact JSON (name, phone, email)"
          },
          {
            "name": "request_number",
            "type": "text",
            "label": "Request number (optional; generated when omitted)"
          },
          {
            "name": "notes",
            "type": "textarea",
            "label": "Notes"
          }
        ],
        "resource": "mutualAid",
        "workflowRef": {
          "name": "sos-workspace-actions",
          "checksum": "a70d370aa5ce3051466c84b94f6ade67cb5f281d214ab9ebba3884a55bf6d8cb"
        },
        "onSubmit": "act-mutual-aid-create-submit"
