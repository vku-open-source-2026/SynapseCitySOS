{
  "format": "synapsedx-plugin",
  "formatVersion": 1,
  "plugin": {
    "product": "sos",
    "name": "Situation report desk",
    "slug": "sos-sitrep-desk",
    "audience": "admin",
    "roles": [
      "admin",
      "manager",
      "operator"
    ],
    "widgets": [
      {
        "id": "intro",
        "text": "Capture reporting periods, casualty and resource numbers, and publish a reviewed situation report. The reporting period and event id are required.",
        "type": "heading",
        "title": "SITREP drafting and publication",
        "width": "full"
      },
      {
        "id": "workspace-navigation",
        "type": "navigation",
        "title": "Quick access",
        "width": "full",
        "links": [
          {
            "label": "Overview",
            "target": "page:sos-command-overview",
            "actionId": "act-workspace-navigation-link1"
          },
          {
            "label": "Hazard watch",
            "target": "page:sos-hazard-watch",
            "actionId": "act-workspace-navigation-link2"
          },
          {
            "label": "Dispatch",
            "target": "page:sos-dispatch-board",
            "actionId": "act-workspace-navigation-link3"
          },
          {
            "label": "Resources",
            "target": "page:sos-resource-registry",
            "actionId": "act-workspace-navigation-link4"
          },
          {
            "label": "Team tasks",
            "target": "module:tasks",
            "actionId": "act-workspace-navigation-link5"
          }
        ]
      },
      {
        "id": "sitrep-metric",
        "type": "metric",
        "title": "Situation reports",
        "width": "half",
        "resource": "sitrep",
        "onLoad": "act-sitrep-metric-load"
      },
      {
        "id": "events-metric",
        "type": "metric",
        "title": "Events",
        "width": "half",
        "resource": "events",
        "onLoad": "act-events-metric-load"
      },
      {
        "id": "records-section",
        "type": "divider",
        "title": "Operational picture",
        "width": "full"
      },
      {
        "id": "sitrep-table",
        "type": "table",
        "title": "Situation reports",
        "width": "full",
        "columns": [
          "id",
          "emergency_event_id",
          "title",
          "status",
          "reporting_period_start",
          "reporting_period_end",
          "author",
          "published_at"
        ],
        "resource": "sitrep",
        "onLoad": "act-sitrep-table-load",
        "onRowClick": "act-sitrep-table-row",
        "onExport": "act-sitrep-table-export"
      },
      {
        "id": "actions-section",
        "type": "divider",
        "title": "Take action",
        "width": "full"
      },
      {
        "id": "sitrep-create",
        "type": "form",
        "title": "Create a SITREP",
        "width": "full",
        "action": "create",
        "fields": [
          {
            "name": "emergency_event_id",
            "type": "text",
            "label": "Event id",
            "required": true
          },
          {
            "name": "title",
            "type": "text",
            "label": "Title",
            "required": true
          },
          {
            "name": "reporting_period_start",
            "type": "text",
            "label": "Period start",
            "required": true
          },
          {
            "name": "reporting_period_end",
            "type": "text",
            "label": "Period end",
            "required": true
          },
          {
            "name": "numbers_json",
            "type": "json",
            "label": "Numbers (JSON object)",
            "selectionPath": "numbers"
          },
          {
            "name": "snapshot_json",
            "type": "json",
            "label": "Snapshot (JSON object)",
            "selectionPath": "snapshot"
          },
          {
            "name": "source",
            "type": "text",
            "label": "Source"
          }
        ],
        "resource": "sitrep",
        "workflowRef": {
          "name": "sos-workspace-actions",
          "checksum": "a70d370aa5ce3051466c84b94f6ade67cb5f281d214ab9ebba3884a55bf6d8cb"
