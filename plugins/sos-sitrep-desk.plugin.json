            "name": "record_id",
            "type": "text",
            "label": "SITREP id",
            "required": true
          },
          {
            "name": "title",
            "type": "text",
            "label": "Title"
          },
          {
            "name": "numbers_json",
            "type": "json",
            "label": "Numbers (JSON object)",
            "selectionPath": "numbers"
          },
          {
            "name": "snapshot_json",
            "type": "json",
            "label": "Snapshot (JSON object)",
