        },
        "onSubmit": "act-sitrep-publish-submit"
      },
      {
        "id": "aar-publish",
        "type": "form",
        "title": "Publish an AAR",
        "width": "half",
        "action": "execute",
        "fields": [
          {
            "name": "record_id",
            "type": "text",
            "label": "AAR id",
            "required": true
          },
          {
            "name": "decision",
            "type": "text",
            "label": "Decision: publish"
          }
        ],
        "resource": "afterAction",
        "workflowRef": {
          "name": "sos-workspace-actions",
