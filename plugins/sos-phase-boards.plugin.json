{
  "format": "synapsedx-plugin",
  "formatVersion": 1,
  "plugin": {
    "product": "sos",
    "name": "Emergency phase boards",
    "slug": "sos-phase-boards",
    "audience": "admin",
    "roles": [
      "admin",
      "manager",
      "operator"
    ],
    "widgets": [
      {
        "id": "before",
        "text": "Resource readiness, EOP plans and hazard context before an event. Use the event and EOP pages to open a plan or move an event into monitoring.",
        "type": "heading",
        "title": "Before a disaster: readiness",
        "width": "full"
      },
      {
        "id": "workspace-navigation",
        "type": "navigation",
        "title": "Quick access",
        "width": "full",
        "links": [
          {
            "label": "Overview",
            "target": "page:sos-command-overview",
            "actionId": "act-workspace-navigation-link1"
          },
          {
            "label": "Hazard watch",
            "target": "page:sos-hazard-watch",
            "actionId": "act-workspace-navigation-link2"
          },
          {
            "label": "Dispatch",
            "target": "page:sos-dispatch-board",
            "actionId": "act-workspace-navigation-link3"
          },
          {
            "label": "Resources",
            "target": "page:sos-resource-registry",
            "actionId": "act-workspace-navigation-link4"
          },
          {
            "label": "Team tasks",
            "target": "module:tasks",
            "actionId": "act-workspace-navigation-link5"
          }
        ]
      },
      {
        "id": "during",
        "text": "Active events, dispatch queue, resources on scene and the latest SITREP. Updates use the dispatch and SITREP workflows.",
        "type": "text",
        "title": "During a disaster: command",
        "width": "full"
      },
      {
        "id": "after",
        "text": "Resolved events, after-action reports and lessons learned. Closing an event creates a draft AAR for review.",
        "type": "text",
        "title": "After a disaster: review",
        "width": "full"
      },
      {
        "id": "events-metric",
        "type": "metric",
        "title": "Events",
        "width": "half",
        "resource": "events",
        "onLoad": "act-events-metric-load"
      },
      {
        "id": "eop-metric",
        "type": "metric",
        "title": "EOP plans",
        "width": "half",
        "resource": "eop",
        "onLoad": "act-eop-metric-load"
      },
      {
        "id": "dispatch-metric",
        "type": "metric",
        "title": "Dispatch orders",
        "width": "half",
        "resource": "dispatch",
        "onLoad": "act-dispatch-metric-load"
      },
      {
        "id": "resources-metric",
        "type": "metric",
        "title": "Resource units",
        "width": "half",
        "resource": "resources",
        "onLoad": "act-resources-metric-load"
      },
      {
        "id": "sitrep-metric",
        "type": "metric",
        "title": "SITREPs",
        "width": "half",
        "resource": "sitrep",
        "onLoad": "act-sitrep-metric-load"
      },
      {
        "id": "aar-metric",
        "type": "metric",
        "title": "AARs",
        "width": "half",
        "resource": "afterAction",
        "onLoad": "act-aar-metric-load"
      },
      {
        "id": "records-section",
        "type": "divider",
        "title": "Operational picture",
        "width": "full"
      },
      {
        "id": "events-table",
        "type": "table",
        "title": "Event phase board",
        "width": "full",
        "columns": [
          "id",
          "event_code",
          "title",
          "event_type",
          "severity",
          "status",
          "started_at",
          "ended_at"
        ],
        "resource": "events",
        "onLoad": "act-events-table-load",
        "onRowClick": "act-events-table-row",
        "onExport": "act-events-table-export"
      },
      {
        "id": "eop-table",
        "type": "table",
        "title": "Readiness plans",
        "width": "full",
        "columns": [
          "id",
          "emergency_event_id",
          "version",
          "title",
          "status",
          "approved_at",
          "published_at"
        ],
        "resource": "eop",
        "onLoad": "act-eop-table-load",
        "onRowClick": "act-eop-table-row",
        "onExport": "act-eop-table-export"
      },
      {
        "id": "dispatch-table",
        "type": "table",
        "title": "Operations board",
        "width": "full",
        "columns": [
          "id",
          "emergency_event_id",
          "task_title",
          "priority",
          "status",
          "assigned_resource_unit_id"
        ],
        "resource": "dispatch",
        "onLoad": "act-dispatch-table-load",
        "onRowClick": "act-dispatch-table-row",
        "onExport": "act-dispatch-table-export"
      },
      {
        "id": "sitrep-table",
        "type": "table",
        "title": "Situation reports",
        "width": "full",
        "columns": [
          "id",
          "emergency_event_id",
          "title",
          "status",
          "reporting_period_end",
          "published_at"
        ],
        "resource": "sitrep",
        "onLoad": "act-sitrep-table-load",
        "onRowClick": "act-sitrep-table-row",
        "onExport": "act-sitrep-table-export"
      },
      {
        "id": "aar-table",
        "type": "table",
        "title": "After-action board",
        "width": "full",
        "columns": [
          "id",
          "report_code",
          "emergency_event_id",
          "title",
          "status",
          "published_at"
        ],
        "resource": "afterAction",
        "onLoad": "act-aar-table-load",
        "onRowClick": "act-aar-table-row",
        "onExport": "act-aar-table-export"
      },
      {
        "id": "actions-section",
        "type": "divider",
        "title": "Take action",
        "width": "full"
      },
      {
        "id": "eop-publish",
        "type": "form",
        "title": "Publish an EOP plan",
        "width": "half",
        "action": "execute",
        "fields": [
          {
            "name": "record_id",
            "type": "text",
            "label": "EOP id",
            "required": true
          },
          {
            "name": "decision",
            "type": "text",
            "label": "Decision: publish"
          },
          {
            "name": "notes",
            "type": "textarea",
            "label": "Note"
          }
        ],
        "resource": "eop",
        "workflowRef": {
          "name": "sos-workspace-actions",
          "checksum": "06b0881691d078f0adabb3157395d1b2f4f2ff13eab2f9767d590a5af15369f0"
        },
        "onSubmit": "act-eop-publish-submit"
      },
      {
