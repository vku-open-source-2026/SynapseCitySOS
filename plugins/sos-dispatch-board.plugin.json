      },
      {
        "id": "events-metric",
        "type": "metric",
        "title": "Active events",
        "width": "half",
        "resource": "events",
        "onLoad": "act-events-metric-load"
      },
      {
        "id": "records-section",
        "type": "divider",
        "title": "Operational picture",
        "width": "full"
      },
      {
        "id": "dispatch-table",
        "type": "table",
        "title": "Dispatch queue",
        "width": "full",
        "columns": [
          "id",
          "emergency_event_id",
          "task_title",
          "priority",
          "status",
          "assigned_resource_unit_id",
          "eta_minutes",
          "completed_at"
