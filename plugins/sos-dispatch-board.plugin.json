        "id": "dispatch-create",
        "type": "form",
        "title": "Create a dispatch order",
        "width": "full",
        "action": "create",
        "fields": [
          {
            "name": "emergency_event_id",
            "type": "text",
            "label": "Event id",
            "required": true
          },
          {
            "name": "task_title",
            "type": "text",
            "label": "Task",
            "required": true
          },
          {
            "name": "priority",
            "type": "text",
            "label": "Priority"
          },
          {
            "name": "task_description",
            "type": "textarea",
            "label": "Instructions"
          },
          {
            "name": "eta_minutes",
            "type": "number",
            "label": "ETA minutes"
          }
        ],
        "resource": "dispatch",
        "workflowRef": {
          "name": "sos-dispatch-create",
          "checksum": "304737a89aa4d269ace185f2552731ed1a27339c7d360645b7208664ac6b7b3c"
        },
        "onSubmit": "act-dispatch-create-submit"
      },
