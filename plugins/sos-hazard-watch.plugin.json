{
  "format": "synapsedx-plugin",
  "formatVersion": 1,
  "plugin": {
    "product": "sos",
    "name": "Hazard watch and ingest",
    "slug": "sos-hazard-watch",
    "audience": "admin",
    "roles": [
      "admin",
      "manager",
      "operator"
    ],
    "widgets": [
      {
        "id": "intro",
        "text": "Monitor active hazard layers, record manual hazards and track hazard-ingest jobs. The public hazard map remains a Tier-3 public surface.",
        "type": "heading",
        "title": "Hazard layers and VNDMS ingest runs",
        "width": "full"
      },
      {
        "id": "workspace-navigation",
        "type": "navigation",
        "title": "Quick access",
        "width": "full",
        "links": [
          {
            "label": "Overview",
            "target": "page:sos-command-overview",
            "actionId": "act-workspace-navigation-link1"
          },
          {
            "label": "Hazard watch",
            "target": "page:sos-hazard-watch",
            "actionId": "act-workspace-navigation-link2"
          },
          {
            "label": "Dispatch",
            "target": "page:sos-dispatch-board",
            "actionId": "act-workspace-navigation-link3"
          },
          {
            "label": "Resources",
            "target": "page:sos-resource-registry",
            "actionId": "act-workspace-navigation-link4"
          },
          {
            "label": "Team tasks",
            "target": "module:tasks",
            "actionId": "act-workspace-navigation-link5"
          }
        ]
      },
      {
        "id": "hazards-metric",
        "type": "metric",
        "title": "Hazard layers",
        "width": "half",
        "resource": "hazards",
        "onLoad": "act-hazards-metric-load"
      },
      {
        "id": "ingest-metric",
        "type": "metric",
        "title": "Ingest runs",
        "width": "half",
        "resource": "hazardIngest",
        "onLoad": "act-ingest-metric-load"
      },
      {
        "id": "hazards-map",
        "type": "map",
        "title": "Hazards · Live map",
        "width": "full",
        "resource": "hazards",
        "columns": [
          "id",
          "name",
          "title",
          "status",
          "severity",
          "address",
          "district",
          "latitude",
          "longitude",
          "geometry",
          "geometry_json",
          "location",
          "current_location",
          "current_location_json"
        ],
        "onLoad": "act-hazards-map-load",
        "onRowClick": "act-hazards-map-row",
        "onExport": "act-hazards-map-export"
      },
      {
        "id": "records-section",
        "type": "divider",
        "title": "Operational picture",
        "width": "full"
      },
      {
        "id": "hazards-table",
        "type": "table",
        "title": "Hazard layers",
        "width": "full",
        "columns": [
          "id",
          "hazard_id",
          "title",
          "event_type",
          "severity",
          "source",
          "is_active",
          "district",
          "detected_at",
          "expires_at"
        ],
        "resource": "hazards",
        "onLoad": "act-hazards-table-load",
        "onRowClick": "act-hazards-table-row",
        "onExport": "act-hazards-table-export"
      },
      {
        "id": "ingest-table",
        "type": "table",
        "title": "Ingest runs",
        "width": "full",
        "columns": [
          "id",
          "source",
          "status",
          "started_at",
          "finished_at",
          "hazards_seen",
          "hazards_ingested",
          "error_message"
        ],
        "resource": "hazardIngest",
        "onLoad": "act-ingest-table-load",
        "onRowClick": "act-ingest-table-row",
        "onExport": "act-ingest-table-export"
      },
      {
        "id": "actions-section",
        "type": "divider",
        "title": "Take action",
        "width": "full"
      },
      {
