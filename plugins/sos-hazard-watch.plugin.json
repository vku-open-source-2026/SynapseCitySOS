            "type": "text",
            "label": "Hazard id",
            "required": true
          },
          {
            "name": "title",
            "type": "text",
            "label": "Title"
          },
          {
            "name": "severity",
            "type": "text",
            "label": "Severity"
          },
          {
            "name": "is_active",
            "type": "text",
            "label": "Active: true or false"
