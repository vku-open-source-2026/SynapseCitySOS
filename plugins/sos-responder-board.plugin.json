{
  "format": "synapsedx-plugin",
  "formatVersion": 1,
  "plugin": {
    "product": "sos",
    "name": "Responder board",
    "slug": "sos-responder-board",
    "audience": "member",
    "roles": [
      "responder"
    ],
    "widgets": [
      {
        "id": "intro",
        "text": "Your active assignment, resource status and event context. Task transitions are bound to the same SOS workflows used by the command centre.",
        "type": "text",
        "title": "Responder assignment board",
        "width": "full"
      },
      {
        "id": "dispatch-metric",
        "type": "metric",
        "title": "Assigned tasks",
        "width": "half",
        "resource": "dispatch"
      },
      {
        "id": "resources-metric",
        "type": "metric",
        "title": "Resources",
        "width": "half",
        "resource": "resources"
      },
      {
        "id": "events-metric",
        "type": "metric",
        "title": "Active events",
        "width": "half",
        "resource": "events"
      },
      {
        "id": "sitrep-metric",
        "type": "metric",
        "title": "SITREPs",
        "width": "half",
        "resource": "sitrep"
      },
      {
        "id": "dispatch-table",
        "type": "table",
        "title": "Assignments",
        "width": "full",
        "columns": [
          "id",
          "emergency_event_id",
          "task_title",
          "priority",
          "status",
          "assigned_resource_unit_id",
          "eta_minutes"
        ],
        "resource": "dispatch"
      },
      {
        "id": "resources-table",
        "type": "table",
        "title": "Resource status",
        "width": "full",
        "columns": [
          "id",
          "resource_code",
          "name",
          "resource_type",
          "status",
          "district"
        ],
        "resource": "resources"
      },
      {
        "id": "events-table",
        "type": "table",
        "title": "Event context",
        "width": "full",
        "columns": [
          "id",
          "event_code",
          "title",
          "event_type",
          "severity",
          "status",
          "started_at"
        ],
        "resource": "events"
      },
      {
        "id": "sitrep-table",
        "type": "table",
        "title": "Situation reports",
        "width": "full",
        "columns": [
          "id",
          "emergency_event_id",
          "title",
          "status",
          "published_at"
        ],
        "resource": "sitrep"
      },
      {
        "id": "dispatch-start",
        "type": "form",
        "title": "Start my task",
        "width": "half",
        "action": "execute",
        "fields": [
          {
            "name": "record_id",
            "type": "text",
            "label": "Dispatch id",
            "required": true
          },
          {
            "name": "decision",
            "type": "text",
            "label": "Decision: start"
          }
        ],
        "resource": "dispatch",
        "workflowRef": {
          "name": "sos-workspace-actions",
          "checksum": "06b0881691d078f0adabb3157395d1b2f4f2ff13eab2f9767d590a5af15369f0"
        }
      },
      {
        "id": "dispatch-arrive",
        "type": "form",
        "title": "Mark on scene",
        "width": "half",
        "action": "execute",
        "fields": [
          {
            "name": "record_id",
            "type": "text",
            "label": "Dispatch id",
            "required": true
          },
          {
            "name": "decision",
            "type": "text",
            "label": "Decision: arrive"
          }
        ],
        "resource": "dispatch",
        "workflowRef": {
          "name": "sos-workspace-actions",
          "checksum": "06b0881691d078f0adabb3157395d1b2f4f2ff13eab2f9767d590a5af15369f0"
        }
      },
      {
        "id": "dispatch-complete",
        "type": "form",
        "title": "Complete my task",
        "width": "half",
        "action": "update",
        "fields": [
          {
            "name": "order_id",
            "type": "text",
            "label": "Dispatch id",
            "required": true
          }
        ],
        "resource": "dispatch",
        "workflowRef": {
          "name": "sos-dispatch-complete",
          "checksum": "db4d5752f4615436852703930ec9ec00f78054b79c879be27385b1225edfe9b2"
        }
      },
      {
        "id": "resource-status",
        "type": "form",
        "title": "Update resource status",
        "width": "half",
        "action": "execute",
        "fields": [
          {
            "name": "record_id",
            "type": "text",
            "label": "Resource id",
            "required": true
          },
          {
            "name": "decision",
            "type": "text",
            "label": "Decision: available, deploy, unavailable or maintain",
            "required": true
          }
        ],
        "resource": "resources",
        "workflowRef": {
          "name": "sos-workspace-actions",
          "checksum": "06b0881691d078f0adabb3157395d1b2f4f2ff13eab2f9767d590a5af15369f0"
        }
      }
    ]
  },
  "source": {
    "repository": "https://github.com/vku-open-source-2026/SynapseCitySOS",
    "path": "plugins/sos-responder-board.plugin.json",
    "revision": "2026-11-14.3"
  },
  "checksum": "sha256:91609718899dae4c1a738a77b8f590893c95d94fffd9532ac157cda25f2b865a"
}
