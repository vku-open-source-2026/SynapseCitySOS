{
  "format": "synapsedx-workflow-source",
  "formatVersion": 3,
  "product": "sos",
  "repository": "https://github.com/vku-open-source-2026/SynapseCitySOS",
  "revision": "2026-11-14.2",
  "status": "source_ready_pending_credential_binding",
  "active": false,
  "trigger": "manualTrigger",
  "description": "Tier-1 workflow definition source for a DX-bound workspace form. Source-ready; DX must bind the credentialRef and artifact pins before execution.",
  "bindingEnvelope": [
    "pluginId",
    "widgetId",
    "product",
    "resource",
    "submittedBy",
    "submittedAt",
    "fields",
    "action"
  ],
  "persistence": {
    "transport": "httpRequest",
    "endpointTemplate": "https://synapsedx.sbs/v1/capabilities/datasets/{dataset}/records",
    "method": "POST",
    "bodyShape": "{ data: <domain record>, publish: <boolean> }",
    "datasetSource": "derived server-side from product+resource",
    "userSuppliedBinding": "rejected",
    "credentialRef": "synapsedx-organization",
    "credentialHeader": "X-API-Key",
    "credentialKind": "api-key",
    "note": "The portable source stores a credentialRef, never a deployment-local credential id or secret. DX/workflow worker must resolve it to a same-org Tier-2 API-key credential before execution.",
    "datasetByResource": {
      "events": "sos-emergency-events",
      "dispatch": "sos-dispatch-orders"
    },
    "credentialBinding": {
      "owner": "DX workflow management (workflow worker)",
      "resolvedTo": "per-organization technical owner-only encrypted api-key credential",
      "exportRebinding": "DX export rewrites the bound deployment credential into the portable source reference; no id or secret is written to the repository",
      "runtimeChecksum": "DX verifies the artifact graph checksum/revision pins at execution",
      "status": "pending_dx_binding"
    },
    "transitionTransport": "httpRequest GET(includeInput:true) -> code merge/invariant check -> PATCH full data with ifVersion"
  },
  "pluginWidgetBinding": {
    "portableField": "workflowRef",
    "resolvedFields": [
      "workflowArtifactId",
      "workflowArtifactRevision",
      "workflowArtifactChecksum"
    ],
    "note": "Portable bundles cannot carry environment-specific artifact ids or pins. DX binds them at import/install/publish."
  },
  "deploymentGate": "Do not activate or deploy until the credential binding, artifact pinning, and engine test on the deployment are verified. Tier-3 pages stay live until then.",
  "workflows": [
    {
      "operation": "emergency.events.create",
      "workflow": "sos-event-create",
      "file": "plugins/workflows/sos-event-create.workflow.json",
      "dataset": "sos-emergency-events",
      "method": "POST",
      "status": "source_ready_pending_credential_binding",
      "resource": "events"
    },
    {
      "operation": "emergency.dispatch.create",
      "workflow": "sos-dispatch-create",
      "file": "plugins/workflows/sos-dispatch-create.workflow.json",
      "dataset": "sos-dispatch-orders",
      "method": "POST",
      "status": "source_ready_pending_credential_binding",
      "resource": "dispatch"
    },
    {
      "operation": "dispatch.complete",
      "workflow": "sos-dispatch-complete",
      "file": "plugins/workflows/sos-dispatch-complete.workflow.json",
      "dataset": "sos-dispatch-orders",
      "method": "PATCH",
      "resource": "dispatch",
      "status": "source_ready_pending_credential_binding",
      "allowedFrom": [
        "pending",
        "assigned",
        "in_transit",
        "on_scene"
      ],
      "requiresAssignment": true
    },
    {
      "operation": "dispatch.reject",
      "workflow": "sos-dispatch-reject",
      "file": "plugins/workflows/sos-dispatch-reject.workflow.json",
      "dataset": "sos-dispatch-orders",
      "method": "PATCH",
      "resource": "dispatch",
      "status": "source_ready_pending_credential_binding",
      "allowedFrom": [
        "pending",
        "assigned"
      ]
    },
    {
      "operation": "emergency.close",
      "workflow": "sos-event-close",
      "file": "plugins/workflows/sos-event-close.workflow.json",
      "dataset": "sos-emergency-events",
      "method": "PATCH",
      "resource": "events",
      "status": "source_ready_pending_credential_binding",
      "allowedFrom": [
        "monitoring",
        "active",
        "contained"
      ],
      "idempotentWhen": {
        "status": "resolved"
      },
      "createsBefore": {
        "dataset": "sos-after-action-reports"
      }
    }
  ],
  "engineContract": {
    "httpRequestTypeVersion": 4,
    "includeInput": true,
    "includeInputResultShape": "{statusCode, body, input}",
    "credentialAuth": {
      "credentialRef": "synapsedx-organization",
      "header": "X-API-Key",
      "allowedOrigins": [
        "https://synapsedx.sbs"
      ]
    },
    "note": "Credential-backed httpRequest nodes declare an exact destination origin allowlist. The workflow worker must keep allowedOrigins pinned when it binds credentialRef."
  },
  "transitionRules": {
    "dispatch": {
      "dataset": "sos-dispatch-orders",
      "terminalStatuses": [
        "completed",
        "canceled",
        "rejected"
      ],
      "merge": "GET(includeInput:true) -> validate state -> merge patch over full record -> PATCH {data,ifVersion}"
    },
    "complete": {
      "operation": "dispatch.complete",
      "allowedFrom": [
        "pending",
        "assigned",
        "in_transit",
        "on_scene"
      ],
      "patch": {
        "status": "completed",
        "completed_at": "{now}"
      },
      "requiresAssignment": true,
      "invariants": [
        "completed/canceled/rejected orders cannot be re-completed",
        "an order must have an assigned_resource_unit_id (or a legacy assignment with the same id) before completion",
        "completed_at is captured once in the validation node"
      ]
    },
    "reject": {
      "operation": "dispatch.reject",
      "allowedFrom": [
        "pending",
        "assigned"
      ],
      "patch": {
        "status": "canceled"
      },
      "invariants": [
        "a completed/canceled order cannot be rejected again",
        "the assignment history is preserved by the full-record merge"
      ]
    },
    "close": {
      "operation": "emergency.close",
      "dataset": "sos-emergency-events",
      "allowedFrom": [
        "monitoring",
        "active",
        "contained"
      ],
      "idempotentStatuses": [
        "resolved"
      ],
      "refusedStatuses": [
        "canceled",
        "archived"
      ],
      "patch": {
        "status": "resolved",
        "ended_at": "{closedAt}",
        "resolution_note": "{resolution_note or existing}",
        "after_action_report_id": "{aar_id}",
        "resolved_by": "{submittedBy}"
      },
      "invariants": [
        "the AAR draft is created before the event PATCH",
        "a resolved event is idempotent: no AAR and no event write",
        "an existing AAR for the event is reused instead of duplicated",
        "the AAR event_end and the event ended_at are the same close timestamp",
        "a stale ifVersion returns 409 version_conflict and fails the run"
      ]
    }
  },
  "aarInvariants": {
    "dataset": "sos-after-action-reports",
    "idPattern": "aar-<event_id>-v<version> (sanitized to [A-Za-z0-9_.-], max 180 chars)",
    "reportCodePattern": "AAR-<event_code or event_id>-v<version>",
    "versionSource": "highest existing AAR version for the event (next version only when regenerating; close reuses the latest)",
    "status": "draft",
    "publish": false,
    "generatedBy": "sos-kpi-engine-v1",
    "formula": "overall=0.3*response+0.3*dispatch+0.2*sitrep+0.2*resource",
    "summaryParity": "same three legacy sentences as apps/sos-service computeAfterAction",
    "metadata": [
      "generated_by",
      "formula",
      "event_start",
      "event_end",
      "first_assignment_at",
      "sla_minutes",
      "computed_at",
      "generated_by_user"
    ],
    "kpiParity": "response/dispatch/sitrep/resource values match apps/sos-service/src/after-action.ts",
    "inputBounds": "queries request limit 500 (Tier-2 max page size); total > page fails the run with query_truncated_<collection>; AAR list is ordered version:desc"
  },
  "genericActionWorkflow": {
    "workflow": "sos-workspace-actions",
    "file": "plugins/workflows/sos-workspace-actions.workflow.json",
    "product": "sos",
    "description": "Declarative create/update/delete/execute dispatcher for organization workspace forms. The DX published-plugin binding pins revision and checksum; fields, datasets and statuses are product-owned allowlists.",
    "actions": [
      "create",
      "update",
      "delete",
      "execute"
    ],
    "datasets": {
      "events": "sos-emergency-events",
      "dispatch": "sos-dispatch-orders",
      "resources": "sos-resource-units",
      "sitrep": "sos-sitreps",
      "eop": "sos-eop-plans",
      "afterAction": "sos-after-action-reports",
      "hazards": "sos-hazard-layers",
      "hazardIngest": "sos-hazard-ingest-runs",
      "mutualAid": "sos-mutual-aid-requests"
    },
    "status": "source_ready_pending_credential_binding",
    "generator": "plugins/workflows/generate-workspace-actions.mjs"
  }
}
