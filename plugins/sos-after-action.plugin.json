            "type": "text",
            "label": "AAR id",
            "required": true
          },
          {
            "name": "title",
            "type": "text",
            "label": "Title"
          },
          {
            "name": "summary",
            "type": "textarea",
            "label": "Summary"
          },
          {
            "name": "lessons_learned_json",
