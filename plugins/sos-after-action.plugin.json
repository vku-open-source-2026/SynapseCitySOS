        "id": "aar-create",
        "type": "form",
        "title": "Create an AAR draft",
        "width": "full",
        "action": "create",
        "fields": [
          {
            "name": "emergency_event_id",
            "type": "text",
            "label": "Event id",
            "required": true
          },
          {
            "name": "report_code",
            "type": "text",
            "label": "Report code"
          },
          {
            "name": "title",
            "type": "text",
            "label": "Title",
            "required": true
          },
          {
            "name": "summary",
            "type": "textarea",
            "label": "Summary"
          },
          {
            "name": "lessons_learned_json",
            "type": "json",
            "label": "Lessons learned (JSON array)",
            "selectionPath": "lessons_learned"
          },
          {
            "name": "recommendations_json",
            "type": "json",
            "label": "Recommendations (JSON array)",
            "selectionPath": "recommendations"
          }
