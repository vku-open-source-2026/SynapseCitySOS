{
  "format": "synapsedx-plugin",
  "formatVersion": 1,
  "plugin": {
    "product": "sos",
    "name": "After-action review",
    "slug": "sos-after-action",
    "audience": "admin",
    "roles": [
      "admin",
      "manager"
    ],
    "widgets": [
      {
        "id": "intro",
        "text": "Review the generated timeline and KPI, record lessons and recommendations, then publish the report. Closing an event creates a draft automatically.",
        "type": "heading",
        "title": "After-action reports",
        "width": "full"
      },
      {
        "id": "workspace-navigation",
        "type": "navigation",
        "title": "Quick access",
        "width": "full",
        "links": [
          {
            "label": "Overview",
            "target": "page:sos-command-overview",
            "actionId": "act-workspace-navigation-link1"
          },
          {
            "label": "Hazard watch",
            "target": "page:sos-hazard-watch",
            "actionId": "act-workspace-navigation-link2"
          },
          {
            "label": "Dispatch",
            "target": "page:sos-dispatch-board",
            "actionId": "act-workspace-navigation-link3"
          },
          {
            "label": "Resources",
            "target": "page:sos-resource-registry",
            "actionId": "act-workspace-navigation-link4"
          },
          {
            "label": "Team tasks",
            "target": "module:tasks",
            "actionId": "act-workspace-navigation-link5"
          }
        ]
      },
      {
        "id": "aar-metric",
        "type": "metric",
        "title": "After-action reports",
        "width": "half",
        "resource": "afterAction",
        "onLoad": "act-aar-metric-load"
      },
      {
        "id": "events-metric",
        "type": "metric",
        "title": "Events",
        "width": "half",
        "resource": "events",
        "onLoad": "act-events-metric-load"
      },
      {
        "id": "records-section",
        "type": "divider",
        "title": "Operational picture",
        "width": "full"
      },
      {
        "id": "aar-table",
        "type": "table",
        "title": "After-action reports",
        "width": "full",
        "columns": [
          "id",
          "report_code",
          "emergency_event_id",
          "title",
          "status",
          "version",
          "generated_at",
          "published_at"
        ],
        "resource": "afterAction",
        "onLoad": "act-aar-table-load",
        "onRowClick": "act-aar-table-row",
        "onExport": "act-aar-table-export"
      },
      {
        "id": "actions-section",
        "type": "divider",
        "title": "Take action",
        "width": "full"
      },
