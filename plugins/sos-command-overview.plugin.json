{
  "format": "synapsedx-plugin",
  "formatVersion": 1,
  "plugin": {
    "product": "sos",
    "name": "Emergency command overview",
    "slug": "sos-command-overview",
    "audience": "admin",
    "roles": [
      "admin",
      "manager",
      "operator"
    ],
    "widgets": [
      {
        "id": "intro",
        "type": "text",
        "title": "Emergency operations",
        "text": "Read-only snapshot of emergency events, dispatch orders and resource units. Dispatch, EOP and SITREP writes stay in the SOS product API, which enforces the operator role and emergency permission.",
        "width": "full"
      },
      {
        "id": "events-metric",
        "type": "metric",
        "title": "Emergency events",
        "resource": "events",
        "width": "half"
      },
      {
        "id": "dispatch-metric",
        "type": "metric",
        "title": "Dispatch orders",
        "resource": "dispatch",
        "width": "half"
      },
      {
        "id": "resources-metric",
        "type": "metric",
        "title": "Resource units",
        "resource": "resources",
        "width": "half"
      },
      {
        "id": "sitrep-metric",
        "type": "metric",
        "title": "Situation reports",
        "resource": "sitrep",
        "width": "half"
      },
      {
        "id": "events-table",
        "type": "table",
        "title": "Active events",
        "resource": "events",
        "columns": [
          "id",
          "event_code",
          "title",
          "severity",
          "status",
          "started_at"
        ],
        "width": "full"
      },
      {
        "id": "dispatch-table",
        "type": "table",
        "title": "Dispatch queue",
        "resource": "dispatch",
        "columns": [
          "id",
          "emergency_event_id",
          "task_title",
          "priority",
          "status",
          "created_at"
        ],
        "width": "full"
      },
      {
        "id": "resources-table",
        "type": "table",
        "title": "Resource availability",
        "resource": "resources",
        "columns": [
          "id",
          "resource_code",
          "name",
          "resource_type",
          "status",
          "district"
        ],
        "width": "full"
      },
      {
        "id": "event-create-form",
        "type": "form",
        "title": "Open an emergency event",
        "resource": "events",
        "action": "create",
        "workflowRef": {
          "name": "sos-event-create",
          "slug": "sos-event-create"
        },
        "width": "full",
        "fields": [
          {
            "name": "title",
            "label": "Title",
            "type": "text",
            "required": true
          },
          {
            "name": "event_type",
            "label": "Event type",
            "type": "text",
            "required": true
          },
          {
            "name": "severity",
            "label": "Severity",
            "type": "text",
            "required": true
          },
          {
            "name": "description",
            "label": "Description",
            "type": "textarea"
          }
        ]
      },
      {
        "id": "dispatch-create-form",
        "type": "form",
        "title": "Create a dispatch order",
        "resource": "dispatch",
        "action": "create",
        "workflowRef": {
          "name": "sos-dispatch-create",
          "slug": "sos-dispatch-create"
        },
        "width": "full",
        "fields": [
          {
            "name": "emergency_event_id",
            "label": "Emergency event id",
            "type": "text",
            "required": true
          },
          {
            "name": "task_title",
            "label": "Task",
            "type": "text",
            "required": true
          },
          {
            "name": "priority",
            "label": "Priority",
            "type": "text"
          },
          {
            "name": "task_description",
            "label": "Instructions",
            "type": "textarea"
          }
        ]
      },
      {
        "id": "dispatch-complete-form",
        "type": "form",
        "title": "Complete a dispatch order",
        "resource": "dispatch",
        "action": "update",
        "workflowRef": {
          "name": "sos-dispatch-complete",
          "slug": "sos-dispatch-complete"
        },
        "width": "half",
        "fields": [
          {
            "name": "order_id",
            "label": "Dispatch order id",
            "type": "text",
            "required": true
          }
        ]
      },
      {
        "id": "dispatch-reject-form",
        "type": "form",
        "title": "Reject a dispatch order",
        "resource": "dispatch",
        "action": "update",
        "workflowRef": {
          "name": "sos-dispatch-reject",
          "slug": "sos-dispatch-reject"
        },
        "width": "half",
        "fields": [
          {
            "name": "order_id",
            "label": "Dispatch order id",
            "type": "text",
            "required": true
          }
        ]
      },
      {
        "id": "event-close-form",
        "type": "form",
        "title": "Close an emergency event",
        "resource": "events",
        "action": "update",
        "workflowRef": {
          "name": "sos-event-close",
          "slug": "sos-event-close"
        },
        "width": "full",
        "fields": [
          {
            "name": "event_id",
            "label": "Emergency event id",
            "type": "text",
            "required": true
          },
          {
            "name": "resolution_note",
            "label": "Resolution note",
            "type": "textarea"
          }
        ]
      }
    ]
  },
  "source": {
    "repository": "https://github.com/vku-open-source-2026/SynapseCitySOS",
    "path": "plugins/sos-command-overview.plugin.json",
    "revision": "2026-11-14"
  },
  "checksum": "sha256:931cb74562c0fb998b5e9d5e5511ab23a1edf89feb7ed60c7e9664a15a02d970"
}
