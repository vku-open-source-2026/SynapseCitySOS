{
  "format": "synapsedx-plugin",
  "formatVersion": 1,
  "plugin": {
    "product": "sos",
    "name": "Emergency command overview",
    "slug": "sos-command-overview",
    "audience": "admin",
    "roles": [
      "admin",
      "manager",
      "operator"
    ],
    "widgets": [
      {
        "id": "intro",
        "text": "Live command picture across emergency events, dispatch orders, resource units, situation reports, EOP plans, after-action reports, hazard layers and mutual-aid requests. Reads use Tier-2 SOS datasets; actions are reviewed SOS workflows.",
        "type": "text",
        "title": "Emergency operations at a glance",
        "width": "full"
      },
      {
        "id": "events-metric",
        "type": "metric",
        "title": "Emergency events",
        "width": "half",
        "resource": "events"
      },
      {
        "id": "dispatch-metric",
        "type": "metric",
        "title": "Dispatch orders",
        "width": "half",
        "resource": "dispatch"
      },
      {
        "id": "resources-metric",
        "type": "metric",
        "title": "Resource units",
        "width": "half",
        "resource": "resources"
      },
      {
        "id": "sitrep-metric",
        "type": "metric",
        "title": "Situation reports",
        "width": "half",
        "resource": "sitrep"
      },
      {
        "id": "eop-metric",
        "type": "metric",
        "title": "EOP plans",
        "width": "half",
        "resource": "eop"
      },
      {
        "id": "aar-metric",
        "type": "metric",
        "title": "After-action reports",
        "width": "half",
        "resource": "afterAction"
      },
      {
        "id": "hazards-metric",
        "type": "metric",
        "title": "Hazard layers",
        "width": "half",
        "resource": "hazards"
      },
      {
        "id": "mutual-aid-metric",
        "type": "metric",
        "title": "Mutual-aid requests",
        "width": "half",
        "resource": "mutualAid"
      },
      {
        "id": "events-table",
        "type": "table",
        "title": "Emergency events",
        "width": "full",
        "columns": [
          "id",
          "event_code",
          "title",
          "event_type",
          "severity",
          "status",
          "started_at"
        ],
        "resource": "events"
      },
      {
        "id": "dispatch-table",
        "type": "table",
        "title": "Dispatch queue",
        "width": "full",
        "columns": [
          "id",
          "emergency_event_id",
          "task_title",
          "priority",
          "status",
          "assigned_resource_unit_id"
        ],
        "resource": "dispatch"
      },
      {
        "id": "resources-table",
        "type": "table",
        "title": "Resource availability",
        "width": "full",
        "columns": [
          "id",
          "resource_code",
          "name",
          "resource_type",
          "status",
          "district"
        ],
        "resource": "resources"
      },
      {
        "id": "sitrep-table",
        "type": "table",
        "title": "Situation reports",
        "width": "full",
        "columns": [
          "id",
          "emergency_event_id",
          "title",
          "status",
          "reporting_period_end",
          "published_at"
        ],
        "resource": "sitrep"
      },
      {
        "id": "event-create",
        "type": "form",
        "title": "Open an emergency event",
        "width": "full",
        "action": "create",
        "fields": [
          {
            "name": "title",
            "type": "text",
            "label": "Title",
            "required": true
          },
          {
            "name": "event_type",
            "type": "text",
            "label": "Event type",
            "required": true
          },
          {
            "name": "severity",
            "type": "text",
            "label": "Severity",
            "required": true
          },
          {
            "name": "description",
            "type": "textarea",
            "label": "Description"
          }
        ],
        "resource": "events",
        "workflowRef": {
          "name": "sos-event-create",
          "checksum": "c4cc3147e75398800e3248d19b0c7e6ed2f094b9e6c3122331d93964687dd4ef"
        }
      },
      {
        "id": "dispatch-create",
        "type": "form",
        "title": "Create a dispatch order",
        "width": "full",
        "action": "create",
        "fields": [
          {
            "name": "emergency_event_id",
            "type": "text",
            "label": "Emergency event id",
            "required": true
          },
          {
            "name": "task_title",
            "type": "text",
            "label": "Task",
            "required": true
          },
          {
            "name": "priority",
            "type": "text",
            "label": "Priority"
          },
          {
            "name": "task_description",
            "type": "textarea",
            "label": "Instructions"
          }
        ],
        "resource": "dispatch",
        "workflowRef": {
          "name": "sos-dispatch-create",
          "checksum": "588826887db9c32c481597efa4323d65e823e32d2ef2f9519f9b1b217f2ac628"
        }
      },
      {
        "id": "event-close",
        "type": "form",
        "title": "Close an emergency event",
        "width": "full",
        "action": "update",
        "fields": [
          {
            "name": "event_id",
            "type": "text",
            "label": "Emergency event id",
            "required": true
          },
          {
            "name": "resolution_note",
            "type": "textarea",
            "label": "Resolution note"
          }
        ],
        "resource": "events",
        "workflowRef": {
          "name": "sos-event-close",
          "checksum": "61bb9f85be7659ed76a0f9b922a38d5d735e42d2e90081b5d903ba418ccdc225"
        }
      }
    ]
  },
  "source": {
    "repository": "https://github.com/vku-open-source-2026/SynapseCitySOS",
    "path": "plugins/sos-command-overview.plugin.json",
    "revision": "2026-11-14.3"
