{
  "format": "synapsedx-plugin",
  "formatVersion": 1,
  "plugin": {
    "product": "sos",
    "name": "Emergency command overview",
    "slug": "sos-command-overview",
    "audience": "admin",
    "roles": [
      "admin",
      "manager",
      "operator"
    ],
    "widgets": [
      {
        "id": "intro",
        "text": "Live command picture across emergency events, dispatch orders, resource units, situation reports, EOP plans, after-action reports, hazard layers and mutual-aid requests. Reads use Tier-2 SOS datasets; actions are reviewed SOS workflows.",
        "type": "heading",
        "title": "Emergency operations at a glance",
        "width": "full"
      },
      {
        "id": "workspace-navigation",
        "type": "navigation",
        "title": "Quick access",
        "width": "full",
        "links": [
          {
            "label": "Overview",
            "target": "page:sos-command-overview",
            "actionId": "act-workspace-navigation-link1"
          },
          {
            "label": "Hazard watch",
            "target": "page:sos-hazard-watch",
            "actionId": "act-workspace-navigation-link2"
          },
          {
            "label": "Dispatch",
            "target": "page:sos-dispatch-board",
            "actionId": "act-workspace-navigation-link3"
          },
          {
            "label": "Resources",
            "target": "page:sos-resource-registry",
            "actionId": "act-workspace-navigation-link4"
          },
          {
            "label": "Team tasks",
            "target": "module:tasks",
            "actionId": "act-workspace-navigation-link5"
          }
        ]
      },
      {
        "id": "events-metric",
        "type": "metric",
        "title": "Emergency events",
        "width": "half",
        "resource": "events",
        "onLoad": "act-events-metric-load"
      },
      {
        "id": "dispatch-metric",
