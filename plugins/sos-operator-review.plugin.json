        "type": "form",
        "title": "Publish a SITREP",
        "width": "half",
        "action": "execute",
        "fields": [
          {
            "name": "record_id",
            "type": "text",
            "label": "SITREP id",
            "required": true
          },
          {
            "name": "decision",
            "type": "text",
            "label": "Decision: publish"
          },
          {
            "name": "notes",
            "type": "textarea",
            "label": "Note"
