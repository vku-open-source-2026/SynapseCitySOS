        "fields": [
          {
            "name": "record_id",
            "type": "text",
            "label": "Request id",
            "required": true
          },
          {
            "name": "decision",
            "type": "text",
            "label": "Decision: approve, reject, start or complete",
            "required": true
          },
          {
            "name": "notes",
            "type": "textarea",
            "label": "Note"
          }
        ],
        "resource": "mutualAid",
        "workflowRef": {
