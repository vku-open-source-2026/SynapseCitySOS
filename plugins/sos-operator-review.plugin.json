{
  "format": "synapsedx-plugin",
  "formatVersion": 1,
  "plugin": {
    "product": "sos",
    "name": "SOS operator review",
    "slug": "sos-operator-review",
    "audience": "admin",
    "roles": [
      "admin",
      "manager",
      "operator"
    ],
    "widgets": [
      {
        "id": "intro",
        "text": "Review EOP, SITREP, after-action and mutual-aid records in one place. Decisions execute the reviewed SOS workflow and are attributed to the signed-in member.",
        "type": "heading",
        "title": "Approval and publication lane",
        "width": "full"
      },
      {
        "id": "workspace-navigation",
        "type": "navigation",
        "title": "Quick access",
        "width": "full",
        "links": [
          {
            "label": "Overview",
            "target": "page:sos-command-overview",
            "actionId": "act-workspace-navigation-link1"
          },
          {
            "label": "Hazard watch",
            "target": "page:sos-hazard-watch",
            "actionId": "act-workspace-navigation-link2"
          },
          {
            "label": "Dispatch",
            "target": "page:sos-dispatch-board",
            "actionId": "act-workspace-navigation-link3"
          },
          {
            "label": "Resources",
            "target": "page:sos-resource-registry",
            "actionId": "act-workspace-navigation-link4"
          },
          {
            "label": "Team tasks",
            "target": "module:tasks",
            "actionId": "act-workspace-navigation-link5"
          }
        ]
      },
      {
        "id": "eop-metric",
        "type": "metric",
        "title": "EOP plans",
        "width": "half",
        "resource": "eop",
        "onLoad": "act-eop-metric-load"
      },
      {
        "id": "sitrep-metric",
        "type": "metric",
        "title": "SITREPs",
        "width": "half",
        "resource": "sitrep",
        "onLoad": "act-sitrep-metric-load"
      },
      {
        "id": "aar-metric",
        "type": "metric",
        "title": "AARs",
        "width": "half",
        "resource": "afterAction",
        "onLoad": "act-aar-metric-load"
      },
      {
        "id": "mutual-aid-metric",
        "type": "metric",
        "title": "Mutual-aid requests",
        "width": "half",
        "resource": "mutualAid",
        "onLoad": "act-mutual-aid-metric-load"
      },
      {
        "id": "records-section",
        "type": "divider",
        "title": "Operational picture",
        "width": "full"
      },
      {
        "id": "eop-table",
        "type": "table",
        "title": "EOP review",
        "width": "full",
        "columns": [
          "id",
          "emergency_event_id",
          "version",
          "title",
          "status",
          "approved_at"
        ],
        "resource": "eop",
        "onLoad": "act-eop-table-load",
        "onRowClick": "act-eop-table-row",
        "onExport": "act-eop-table-export"
      },
      {
        "id": "sitrep-table",
        "type": "table",
        "title": "SITREP review",
        "width": "full",
        "columns": [
          "id",
          "emergency_event_id",
          "title",
          "status",
          "reporting_period_end"
        ],
        "resource": "sitrep",
        "onLoad": "act-sitrep-table-load",
        "onRowClick": "act-sitrep-table-row",
        "onExport": "act-sitrep-table-export"
      },
      {
        "id": "aar-table",
        "type": "table",
        "title": "AAR review",
        "width": "full",
        "columns": [
          "id",
          "report_code",
          "emergency_event_id",
          "title",
          "status",
          "generated_at"
        ],
        "resource": "afterAction",
        "onLoad": "act-aar-table-load",
        "onRowClick": "act-aar-table-row",
        "onExport": "act-aar-table-export"
      },
      {
        "id": "mutual-aid-table",
        "type": "table",
        "title": "Mutual-aid review",
        "width": "full",
        "columns": [
          "id",
          "requesting_org",
          "target_org",
          "resource_type",
          "quantity",
          "status"
        ],
        "resource": "mutualAid",
        "onLoad": "act-mutual-aid-table-load",
        "onRowClick": "act-mutual-aid-table-row",
        "onExport": "act-mutual-aid-table-export"
      },
      {
        "id": "actions-section",
        "type": "divider",
        "title": "Take action",
        "width": "full"
      },
      {
        "id": "eop-decision",
        "type": "form",
        "title": "Decide an EOP plan",
        "width": "half",
        "action": "execute",
        "fields": [
          {
            "name": "record_id",
            "type": "text",
            "label": "EOP id",
            "required": true
          },
          {
            "name": "decision",
            "type": "text",
            "label": "Decision: approve, publish or reject",
            "required": true
          },
          {
            "name": "notes",
            "type": "textarea",
            "label": "Note"
          }
        ],
        "resource": "eop",
        "workflowRef": {
          "name": "sos-workspace-actions",
          "checksum": "06b0881691d078f0adabb3157395d1b2f4f2ff13eab2f9767d590a5af15369f0"
        },
        "onSubmit": "act-eop-decision-submit"
      },
      {
